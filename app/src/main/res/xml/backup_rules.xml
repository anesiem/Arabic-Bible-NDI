<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Bundled Bible databases are re-copied from assets on first launch;
         backing them up wastes quota. User styles and preferences ARE backed up. -->
    <exclude domain="database" path="arabic.db"/>
    <exclude domain="database" path="english_asv.db"/>
    <!-- User background videos can be hundreds of MB; re-pickable. -->
    <exclude domain="file" path="backgrounds/"/>
</full-backup-content>
