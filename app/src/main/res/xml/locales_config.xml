<?xml version="1.0" encoding="utf-8"?>
<!-- 1.9.25 (item 2, language mode): enables Android's per-app language
     picker in system Settings. English is the default (res/values/);
     Arabic lives in res/values-ar/. More languages later. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ar" />
</locale-config>
